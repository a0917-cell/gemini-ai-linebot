LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
GEMINI_API_KEY=your_gemini_api_key
GCS_BUCKET=your_gcs_bucket_name
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Pin the File Search store (recommended: the project holds two stores with the same display name).
GEMINI_STORE_NAME=fileSearchStores/your-store-id
# Optional: enables GET /store/info (send as X-Admin-Token). Unset = endpoint always 403.
ADMIN_TOKEN=
# Reminders (plan T9): run scripts/setup_reminder_sheet.py once; it fills these four.
# The refresh token has the drive.file scope only (reaches just the reminder sheet).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
REMINDER_SHEET_ID=
